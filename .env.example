# Copy to .env.local and fill in. Never commit .env.local.

# Spotify — OAuth 2.0 with PKCE
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional: override the OAuth callback (defaults to <origin>/api/auth/spotify/callback)
SPOTIFY_REDIRECT_URI=

# Apple Music — MusicKit developer token
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=        # .p8 contents, newlines as \n

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=          # optional; defaults to <origin>/api/auth/google/callback
YOUTUBE_API_KEY=              # for public playlist reads (no user login)
YOUTUBE_WRITE_ENABLED=false   # feature flag, off until quota approved
YOUTUBE_DAILY_QUOTA=10000

# Session — iron-session cookie encryption key, 32+ chars.
# REQUIRED in production: the app refuses to serve requests without a real
# secret (it won't silently fall back to a dev constant). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Redis — Upstash REST.
# Required in production: the /api/jobs kickoff and the background match run in
# separate function invocations, so they need a shared store to hand off job
# state + progress. In local dev (single node server) the in-memory fallback
# works without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest — durable background matching for large playlists.
# When unset/false, matches run in-process via Next's after() (fine for the
# friend-group scale; bounded by the function timeout). Set to true and run
# `npx inngest-cli dev` (local) or configure Inngest Cloud (prod) to offload
# large playlists to a durable queue. Only public source reads use Inngest;
# private-playlist reads always stay in-process so tokens never leave it.
INNGEST_ENABLED=false

# Storefront / market
DEFAULT_STOREFRONT=us
