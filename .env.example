# Copy to .env.local and fill in. Never commit .env.local.

# Spotify — OAuth 2.0 with PKCE
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music — MusicKit developer token
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=        # .p8 contents, newlines as \n

# YouTube / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=              # for public playlist reads (no user login)
YOUTUBE_WRITE_ENABLED=false   # feature flag, off until quota approved
YOUTUBE_DAILY_QUOTA=10000

# Session — iron-session, 32+ bytes
SESSION_SECRET=

# Redis — Upstash REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Storefront / market
DEFAULT_STOREFRONT=us
