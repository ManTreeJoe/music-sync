        "title": "Piano Concerto No. 21 in C Major, K. 467: II. Andante",
        "artists": ["Wolfgang Amadeus Mozart", "Vladimir Ashkenazy"],
        "isrc": "GBAAA7300123",
        "durationMs": 415000,
        "platformId": "spotify:track:mozart467"
